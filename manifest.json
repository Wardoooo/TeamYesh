{
  "manifest_version": 3,
  "name": "Pisonet From Hell",
  "version": "0.1.0",
  "description": "Pay more. Browse less. Suffer always.",
  "action": {
    "default_title": "Pisonet From Hell"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["overlay/overlay.js"],
      "type": "module",
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "overlay/*.css",
        "assets/sounds/*",
        "assets/img/*",
        "assets/video/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
